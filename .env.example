# Copy to `.env` and fill in the values from the Firebase console.
# All EXPO_PUBLIC_* values are inlined into the app at build time.
#
# Firebase console -> Project settings -> Your apps -> Web app -> Config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Required for Google Sign-In: OAuth 2.0 Web client id
# (Firebase console -> Authentication -> Sign-in method -> Google -> Web SDK config)
# Do not use the Android client ID from google-services.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=897783793219-ipemkt4l9s1l09jfimhhqr8u64eqmhou.apps.googleusercontent.com

# Optional, iOS only
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
